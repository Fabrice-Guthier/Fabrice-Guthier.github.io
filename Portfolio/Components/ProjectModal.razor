@using Portfolio.Models

@if (Project != null)
{
    <div class="modal-backdrop" @onclick="HandleBackdropClick">
        <div class="modal-window" @onclick:stopPropagation="true">

            <button class="close-btn" @onclick="HandleClose">
                <i class="fas fa-times"></i>
            </button>

            <div class="carousel-container">
                @if (HasGallery)
                {
                    <button class="nav-btn prev" @onclick="PreviousImage">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                }

                <img src="@CurrentImage" alt="@Project.Title" class="modal-header-img" />

                @if (HasGallery)
                {
                    <button class="nav-btn next" @onclick="NextImage">
                        <i class="fas fa-chevron-right"></i>
                    </button>

                    <div class="carousel-counter">
                        @(CurrentIndex + 1) / @Project.Gallery.Count
                    </div>
                }
            </div>

            <div class="modal-content">
                <h2 class="modal-title">@Project.Title</h2>

                <div class="pro-card__tags mb-3" style="margin-bottom: 1rem;">
                    @foreach (TechTag tag in Project.Tags)
                    {
                        <span class="tech-badge" style="color:#333; border: 1px solid #ccc; background: #eee;">
                            @tag
                        </span>
                    }
                </div>

                <p class="modal-desc">@Project.Description</p>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public Project? Project { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    // Helper pour les tags (copié/collé, idéalement à mettre dans une classe statique partagée)
    private string GetTagName(TechTag tag) => tag switch
    {
        TechTag.CSharp => "C#",
        TechTag.DotNet => ".NET",
        TechTag.HtmlCss => "HTML/CSS",
        TechTag.Sql => "SQL",
        TechTag.SignalR => "SignalR",
        _ => tag.ToString()
    };

    private int CurrentIndex { get; set; } = 0;

    // Computed Property pour savoir si on a une galerie valide
    private bool HasGallery => Project != null && Project.Gallery != null && Project.Gallery.Count > 1;

    // Récupère l'image courante ou fallback sur la cover
    private string CurrentImage
    {
        get
        {
            if (Project == null) return string.Empty;
            if (Project.Gallery != null && Project.Gallery.Count > 0)
            {
                return Project.Gallery[CurrentIndex];
            }
            return Project.ImageUrl; // Fallback
        }
    }

    // Reset l'index à 0 à chaque ouverture d'un nouveau projet
    protected override void OnParametersSet()
    {
        CurrentIndex = 0;
    }

    private void NextImage()
    {
        if (!HasGallery) return;
        if (CurrentIndex < Project!.Gallery.Count - 1)
        {
            CurrentIndex++;
        }
        else
        {
            CurrentIndex = 0; // Loop retour au début
        }
    }

    private void PreviousImage()
    {
        if (!HasGallery) return;
        if (CurrentIndex > 0)
        {
            CurrentIndex--;
        }
        else
        {
            CurrentIndex = Project!.Gallery.Count - 1; // Loop vers la fin
        }
    }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await OnClose.InvokeAsync();
    }
}