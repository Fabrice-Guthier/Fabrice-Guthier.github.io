@inherits LayoutComponentBase

<div class="page">
    <header class="header">
        <nav class="d-flex container @(IsNavOpen ? "show-nav" : "")">
            <div class="logo">Fabrice GUTHIER</div>
            
            <button class="burger" aria-label="Menu" @onclick="ToggleNav">
                <span class="bar"></span>
            </button>

            <ul class="navbar list-unstyled">
                <li><a href="#accueil" @onclick="CloseNav">Accueil</a></li>
                <li><a href="#competences" @onclick="CloseNav">Compétences</a></li>
                <li><a href="#parcours" @onclick="CloseNav">Parcours</a></li>
                <li><a href="#projets" @onclick="CloseNav">Projets</a></li>
            </ul>

            <div class="topright">
                <div class="socials">
                    <a href="https://www.linkedin.com/in/fabrice-guthier/" class="icon"><i class="fab fa-linkedin"></i></a>
                    <a href="https://github.com/Fabrice-Guthier" class="icon"><i class="fab fa-github"></i></a>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @Body
    </main>

    <footer>
        <div class="container">
            <div class="grid">
                <div class="grid__item">
                    <p class="footer__logo">Fabrice GUTHIER</p>
                    <p>&copy; 2025 - Tous droits réservés</p>
                </div>
            </div>
        </div>
    </footer>
</div>

@code {
    private bool IsNavOpen = false;

    private void ToggleNav()
    {
        IsNavOpen = !IsNavOpen;
        StateHasChanged();
    }

    private void CloseNav()
    {
        IsNavOpen = false;
        StateHasChanged();
    }
}