@page "/"
@using Portfolio.Models
@using Portfolio.Components

<PageTitle>Portfolio - Fabrice GUTHIER</PageTitle>

<section id="accueil" class="hero">
    <div class="container">
        <div class="d-flex grid">
            <div class="grid__item hero__item moi">
                <img src="img/moi.jpg" alt="Fabrice Guthier" style="border-radius: 50%; width: 250px; border: 5px solid rgba(255,255,255,0.2);" />
            </div>
            <div class="grid__item hero__item">
                <h2>Concepteur Développeur d'Applications</h2>
                <h1 class="title">Bonjour, je suis Fabrice GUTHIER</h1>
                <p>Passionné par l'informatique, le Hardware et le clean code.</p>
                <p>Là où d'autres voient des problèmes, <b>je vois des solutions</b></p>
            </div>
        </div>
    </div>
</section>

<section id="competences" class="about">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">À PROPOS DE MOI</h2>
            <p>Fort d'une passion pour le monde de l'informatique depuis mes 6 ans, j'ai été diplôlmé d'un Bac+2 en 2003, après une formation d'un an à l'AFPA en Technicien Supérieur en Informatique de Gestion, relation client/serveur Visual Basic pour le langage et Oracle pour la partie SGBDR.'</p>
            <p>S'en est suivi une carrière de 16 ans dans les Telecoms français, dans laquelle ma capacité d'analyse et de résolution de problèmes a été affutée jour après jour.</p>
            <p>Suite à un accident de travail qui m'a laissé des séquelles lourdes sur mon pied droit, j'ai décidé de revenir à ma passion principale : <b>le monde de l'informatique</b> !</p>
            <p>J'ai donc suivi un nouveau cursus qui m'a permis de me remettre à jour au niveau langage mais aussi pour tout ce qui concerne les méthodes CI/CD, Frameworks, Docker, hébergement web.</p>
            <p>Suite à cette formation d'un an, j'ai été diplômé d'un Bac+3 en Conception Développement d'Applications.</p>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="section-header">
            <h2 class ="section-title">MES EXPÉRIENCES</h2>
        </div>
        <div class="grid">
            @foreach (var service in Services)
            {
                <div class="grid__item">
                    <div class="skill">
                        <div class="skill__icon">
                            <i class="@service.IconClass fa-2x" style="color: #333;"></i>
                        </div>
                        <div class="skill__content">
                            <h3>@service.Title</h3>
                            <ul class="list-unstyled">
                                @foreach (var detail in service.Details)
                                {
                                    <li>@detail</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="parcours">
    <div class="container">

        <div class="section-header" style="margin-top: 1rem;">
            <h2 class="section-title">LANGAGES & FRAMEWORKS</h2>
        </div>
        <div class="hard__skills">
            <div class="grid__skills">
                @foreach (var lang in Languages)
                {
                    <div class="skills__item">
                        <div class="skills__icon" style="border-color: #0078d4;">
                            <i class="@lang.IconClass fa-2x"></i>
                        </div>
                        <span>@lang.Name</span>
                    </div>
                }
            </div>
        </div>

        <div class="section-header" style="margin-top: 4rem;">
            <h2 class="section-title">LOGICIELS MAÎTRISÉS</h2>
        </div>
        <div class="hard__skills">
            <div class="grid__skills">
                @foreach (var skill in Softwares)
                {
                    <div class="skills__item">
                        <div class="skills__icon">
                            <i class="@skill.IconClass fa-2x"></i>
                        </div>
                        <span>@skill.Name</span>
                    </div>
                }
            </div>
        </div>

        <div class="section-header">
            <h2 class="section-title">SOFT SKILLS</h2>
        </div>
        <div class="soft__skills">
            <div class="grid__skills">
                @foreach (var skill in SoftSkills)
                {
                    <div class="skills__item">
                        <div class="skills__icon">
                            <i class="@skill.IconClass fa-2x"></i>
                        </div>
                        <span>@skill.Name</span>
                    </div>
                }
            </div>
        </div>

        <div class="section-header" style="margin-top: 4rem;">
            <h2 class="section-title">HARD SKILLS</h2>
        </div>
        <div class="hard__skills">
            <div class="grid__skills">
                @foreach (var skill in HardSkills)
                {
                    <div class="skills__item">
                        <div class="skills__icon">
                            <i class="@skill.IconClass fa-2x"></i>
                        </div>
                        <span>@skill.Name</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section id="projets" class="projets">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">MES PROJETS</h2>
        </div>

        <div class="grid">
            @foreach (var project in Projects)
            {
                <div class="grid__item">
                    <ProjectCard Item="@project" OnClick="OpenModal" />
                </div>
            }
        </div>
    </div>
</section>

<ProjectModal Project="@SelectedProject" OnClose="CloseModal" />


@code {
